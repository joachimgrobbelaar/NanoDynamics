# ==============================================================================
# NanoDynamics Agentic Grader Platform & Caddy Reverse Proxy
# Automatic TLS/SSL Management for nanodynamics.co.za & api.nanodynamics.co.za
# 301 Permanent Redirect from super-intelligence-solutions.co.za
# ==============================================================================

super-intelligence-solutions.co.za, www.super-intelligence-solutions.co.za, superintelligencesolutions.co.za, www.superintelligencesolutions.co.za {
    redir https://nanodynamics.co.za{uri} permanent
}

nanodynamics.co.za, www.nanodynamics.co.za {
    # Route Agentic Grader & Auth Endpoints
    handle /api/health {
        reverse_proxy 127.0.0.1:9000
    }
    handle /api/grade* {
        reverse_proxy 127.0.0.1:9000
    }
    handle /api/quota {
        reverse_proxy 127.0.0.1:9000
    }
    handle /webhooks/* {
        reverse_proxy 127.0.0.1:9000
    }
    handle /auth/* {
        reverse_proxy 127.0.0.1:9000
    }
    handle /whoami {
        reverse_proxy 127.0.0.1:9000
    }

    # Route OrbitGuard AI simulation endpoints
    handle /api/simulation/* {
        reverse_proxy 127.0.0.1:8056
    }
    handle /api/conjunction/* {
        reverse_proxy 127.0.0.1:8056
    }

    # Main Agentic Grader Landing & Dashboard
    handle {
        root * /var/www/public-description
        try_files {path} {path}.html /index.html
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }
}

api.nanodynamics.co.za {
    reverse_proxy 127.0.0.1:9000 {
        header_up Host {upstream_hostport}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, OPTIONS, PUT, DELETE"
        Access-Control-Allow-Headers "DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization"
    }
}
